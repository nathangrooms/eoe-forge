# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
# Measurement agents build to their own output directories so they can A/B a
# change without disturbing dist/. One of those, dist-after-audit, was committed
# by accident: 271 files, 8.7 MB of build output, on a public repo. Any dist-*
# is build output and none of it belongs in git.
dist-*
dist-ssr
*.local

# Generated proxy sheets. These are produced from card images at run time and a
# stray one in public/ would be served from the live site.
public/*_proxies.pdf
*_proxies.pdf

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# local screenshot tooling
.shots/

# agent screenshot scaffolding
shot.html
tshot.html
navcheck.html
src/__shot.tsx
src/__navcheck.tsx
src/pages/__*.tsx

# Environment files (the VITE_ publishable key is client-visible by design,
# but the file should not be tracked going forward — see CLAUDE.md)
.env
.env.local
.env.*.local
!.env.example
.playtest-harness/
matshot.html
src/__matshot.tsx
dm-harness.*

# Agent working files — never ship to Lovable
scratch/

# Windows/Git-Bash turns a /proc/self/fd/1 redirect into a real file
proc/

# play-mode screenshot harness, written by scripts/play-combat-shots.mjs
play-harness.html
src/dev/__playHarness.tsx

# XMage extraction working data (planning instrument; XMage source is never vendored)
scripts/coverage/.data/

# LLM compilation working data: cached sample, run report, resume checkpoint, and
# the journal of validated rows. Large, regenerable, and the journal can hold a
# whole run's worth of model output.
scripts/coverage/llm/.data/

